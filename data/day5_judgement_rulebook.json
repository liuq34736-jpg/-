  "rules": [
    {
      "id": "TJ-REL-YGB",
      "basis": "DIRECT_SOURCE",
      "status": "EXECUTABLE",
      "sources": [
        "M1-TABLE"
      ],
      "relation": "yong_generates_body",
      "polarity": "favorable",
      "summary": "用生体：存在生助、进益的传统有利倾向。"
    },
    {
      "id": "TJ-REL-BGY",
      "basis": "DIRECT_SOURCE",
      "status": "EXECUTABLE",
      "sources": [
        "M1-TABLE"
      ],
      "relation": "body_generates_yong",
      "polarity": "adverse",
      "summary": "体生用：存在主体向外泄气、耗失的传统不利倾向。"
    },
    {
      "id": "TJ-REL-BCY",
      "basis": "DIRECT_SOURCE",
      "status": "EXECUTABLE",
      "sources": [
        "M1-TABLE"
      ],
      "relation": "body_controls_yong",
      "polarity": "favorable",
      "summary": "体克用：存在主体制约所问事情的传统有利倾向。"
    },
    {
      "id": "TJ-REL-YCB",
      "basis": "DIRECT_SOURCE",
      "status": "EXECUTABLE",
      "sources": [
        "M1-TABLE"
      ],
      "relation": "yong_controls_body",
      "polarity": "adverse",
      "summary": "用克体：存在外部制约主体的传统不利倾向。"
    },
    {
      "id": "TJ-REL-SAME",
      "basis": "DIRECT_SOURCE",
      "status": "EXECUTABLE",
      "sources": [
        "M1-TABLE"
      ],
      "relation": "same_element",
      "polarity": "favorable",
      "summary": "体用比和：存在同类相和的传统有利倾向。"
    },
    {
      "id": "TJ-STRENGTH",
      "basis": "DIRECT_SOURCE",
      "status": "EXECUTABLE",
      "sources": [
        "M1-STRENGTH"
      ],
      "summary": "体宜旺；生体一方宜旺，克体一方宜衰。记录修饰，不改基础生克。"
    },
    {
      "id": "TJ-QUALIFIER",
      "basis": "PROJECT_CONVENTION",
      "status": "EXECUTABLE",
      "sources": [
        "M1-STRENGTH"
      ],
      "summary": "将旺衰编译成受限/加强/有所缓解等定性标签，不翻转关系，不用平代替五级休囚。"
    },
    {
      "id": "TJ-TRADITIONAL-ROLES",
      "basis": "DIRECT_SOURCE",
      "status": "EXECUTABLE",
      "sources": [
        "M1-ROLES",
        "M1-PRIORITY"
      ],
      "summary": "原书体卦为主、用卦为事、互卦为中间、变卦为终，并有先看周易爻辞的条文。"
    },
    {
      "id": "TJ-ROLE-CONTEXT",
      "basis": "PROJECT_CONVENTION",
      "status": "EXECUTABLE",
      "sources": [
        "M1-ROLES",
        "M1-PRIORITY"
      ],
      "summary": "将传统体主用事、互中变终与爻辞阅读提示映射成当前背景、核心变化、内部过程、变化方向；这是项目解释角色，不是古籍直接给出的程序标签。"
    },
    {
      "id": "TJ-SEMANTIC-BOUNDARY",
      "basis": "PROJECT_CONVENTION",
      "status": "EXECUTABLE",
      "sources": [
        "M1-PRIORITY",
        "M1-NONRIGID"
      ],
      "summary": "只逐项保留已批准Frame及其条件禁忌；没有已审核的爻义倾向字段时不按字词强行归类吉凶。"
    },
    {
      "id": "TJ-AUXILIARY",
      "basis": "PROJECT_CONVENTION",
      "status": "EXECUTABLE",
      "sources": [
        "M1-ROLES"
      ],
      "summary": "互/变上下卦对原体比较，仅作低优先级旁证；重复三爻结构不另当独立支持，变卦未动的体部分不重复计入。"
    },
    {
      "id": "TJ-CONFLICT",
      "basis": "PROJECT_CONVENTION",
      "status": "EXECUTABLE",
      "sources": [
        "M1-NONRIGID",
        "M1-PRIORITY"
      ],
      "summary": "有利与不利并存输出mixed，不加总、不抵消；保留本卦体用的基础倾向和所有相反因素。"
    },
    {
      "id": "TJ-PRIORITY",
      "basis": "PROJECT_CONVENTION",
      "status": "EXECUTABLE",
      "sources": [
        "M1-PRIORITY",
        "M1-ROLES",
        "M1-NONRIGID"
      ],
      "summary": "本卦语义与动爻条件为主要阅读层；本卦体用提供基础传统倾向，旺衰修饰；互/变不覆盖主要层。尚不声称拥有可靠的爻义定向合成。"
    },
    {
      "id": "TJ-DISPLAY",
      "basis": "MODERN_INTERPRETATION",
      "status": "EXECUTABLE",
      "sources": [
        "M1-TABLE"
      ],
      "summary": "将古籍吉凶限定呈现为有利/不利/混合的传统结构倾向，禁止确定现实结果、金额、时间及概率。"
    },
    {
      "id": "TJ-STRENGTH-VARIANT",
      "basis": "PROJECT_CONVENTION",
      "status": "CONTEXT_ONLY",
      "sources": [
        "M1-ELEMENTS"
      ],
      "summary": "沿用meihua_strength_v1精确节气月建与旺/衰/平；节气精确交接和00:00换日仍属现有项目选择。"
    },
    {
      "id": "TJ-BODY-VARIANT",
      "basis": "PROJECT_CONVENTION",
      "status": "CONTEXT_ONLY",
      "sources": [
        "M1-ROLES"
      ],
      "summary": "沿用moving_trigram_is_yong_v1；不由本次体用段落追认其为唯一传统版本。"
    },
    {
      "id": "TJ-QIAN-KUN",
      "basis": "DISPUTED",
      "status": "REFERENCE_ONLY",
      "sources": [
        "M1-MUTUAL-EXCEPTION"
      ],
      "summary": "乾坤无互冲突不解决。保留v1互卦数据，乾坤互卦关系不参与本原型倾向合成。"
    },
    {
      "id": "TJ-PENDING-LINE-POLARITY",
      "basis": "NOT_YET_SOURCED",
      "status": "REFERENCE_ONLY",
      "sources": [],
      "summary": "尚无经审核的动爻条件极性及其与体用冲突裁决表；不可假装已实现完整圆机综合断卦。"
    },
    {
      "id": "TJ-PENDING-DOMAIN",
      "basis": "NOT_YET_SOURCED",
      "status": "REFERENCE_ONLY",
      "sources": [],
      "summary": "专业问事分类、克应与应期不执行，不由通用表推定财务、健康、人物和具体事件。"
    }
  ]
