    {
      "id": "M1-ELEMENTS",
      "pdf_pages": [
        13
      ],
      "volume": "卷一",
      "printed_pages": [
        "一"
      ],
      "chapter": "五行生尅、八宮所屬五行、卦氣旺衰",
      "excerpt": "金生水。水生木。木生火。火生土。土生金。",
      "limits": "继续引用已冻结五行和月令输出；本轮不实现起卦或旺衰计算。",
      "page_artifacts": [
        {
          "path": "docs/day5_source_pages/page-13.png",
          "sha256": "a9f2b789fa8b28978b9e5d27d3717172b3185918299600cd63244bbea0c32d42"
