    {
      "id": "M1-NONRIGID",
      "pdf_pages": [
        58
      ],
      "volume": "卷二",
      "printed_pages": [
        "四"
      ],
      "chapter": "卦斷遺論",
      "excerpt": "此理甚盛。不必拘體用也。",
      "limits": "比和例亦有不同结论；不能把单一体用关系当总论，不把书中示例预测移植到用户问题。",
      "page_artifacts": [
        {
          "path": "docs/day5_source_pages/page-58.png",
          "sha256": "995cede5f71329da7c949ed70c896c0cbcb9e1ec93fee7c8419b32646c2c30c7"
