        15
      ],
      "volume": "卷一",
      "printed_pages": [
        "三"
      ],
      "chapter": "互卦",
      "excerpt": "乾坤無互。互其變卦。",
      "limits": "与现行统一取互的v1计算存在CONFLICT。保留原卦计算，原型不据此解决冲突。",
      "page_artifacts": [
        {
          "path": "docs/day5_source_pages/page-15.png",
